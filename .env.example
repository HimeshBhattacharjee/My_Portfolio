# Copy to .env.local (git-ignored) and fill in. In Netlify, set the same names under
# Site configuration > Environment variables. See docs/EMAILJS_SETUP.md.
#
# Every VITE_ value is embedded in the public JavaScript bundle. The EmailJS service ID,
# template ID and public key are designed to be public; protect them by restricting
# allowed origins in the EmailJS dashboard (Account > Security).
#
# Never put the EmailJS PRIVATE key (access token) here or anywhere in this project.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# The recipient is NOT configured here. It is fixed in the EmailJS template's
# "To Email" field, so it never travels from the browser and cannot be changed by a
# visitor. (VITE_CONTACT_TO_EMAIL, used by an earlier version, is no longer read.)